root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{tex,bib,md}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.{py,sh}]
indent_style = space
indent_size = 4

[*.{json,ipynb}]
indent_style = space
indent_size = 1
